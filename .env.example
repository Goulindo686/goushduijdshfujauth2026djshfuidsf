# GouAuth - Environment Configuration

# Porta de execução (Porta 80 na Square Cloud)
PORT=80
HOST=0.0.0.0
NODE_ENV=production

# URL de Conexão com o Banco de Dados PostgreSQL da Square Cloud
# Formato: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://squarecloud:7LCrkqT0hVyYsTEksOMnUBoJ@square-cloud-db-59d8ea3325f74e28ba5b73dbab677f0e.squareweb.app:7002/squarecloud

# Caminho relativo ou absoluto para o certificado CA do banco
DATABASE_CA_PATH=./banco de dados/ca-certificate.crt

# Segredo de Sessão do Admin (Gere uma chave aleatória de 32+ caracteres)
JWT_SECRET=super_secret_gouauth_jwt_key_change_me_in_production_32chars

# Chave mestra de criptografia interna
ENCRYPTION_KEY=super_secret_gouauth_encryption_key_32chars_long!

# Domínio da Aplicação
NEXT_PUBLIC_APP_URL=https://gouauth.squareweb.app
